# Serpantinum boot / disk-unlock screen: plain black, a white-outlined
# "Passphrase" box with a white-outlined field under the title and one white
# dot per typed character. Nothing is drawn until the passphrase is asked for.
#
# The box and the field are each drawn as a left end, a right end and a
# stretched middle, so both grow wider as more characters are typed.

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# --- sizes ---------------------------------------------------------------------
dot_image = Image("dot.png");
dot_step = 16;
field_pad = 16;          # room left and right of the dots inside the field
field_min_w = 272;       # width of the field when it is empty
box_extra = 48;          # box is this much wider than the field
max_dots = Math.Int((screen_w - box_extra - 2 * field_pad - 40) / dot_step);

box_l_image = Image("box_left.png");
box_m_image = Image("box_mid.png");
box_r_image = Image("box_right.png");
box_h = box_l_image.GetHeight();
box_cap = box_l_image.GetWidth();
box_y = Math.Int(screen_h / 2 - box_h / 2);

field_l_image = Image("field_left.png");
field_m_image = Image("field_mid.png");
field_r_image = Image("field_right.png");
field_h = field_l_image.GetHeight();
field_cap = field_l_image.GetWidth();
field_y = box_y + box_h - 24 - field_h;

# --- the box and the field (only while asking for a password) -------------------
box_l = Sprite(box_l_image);
box_m = Sprite(box_m_image);
box_r = Sprite(box_r_image);
field_l = Sprite(field_l_image);
field_m = Sprite(field_m_image);
field_r = Sprite(field_r_image);

# --- title while asking for the disk passphrase ---------------------------------
title_image = Image.Text("Passphrase", 1, 1, 1, 1, "Iosevka Nerd Font 22");
title = Sprite(title_image);
title.SetPosition(screen_w / 2 - title_image.GetWidth() / 2, box_y + 24, 11);
title.SetOpacity(0);

# --- dots ---------------------------------------------------------------------------

for (i = 0; i < max_dots; i++) {
    dots[i] = Sprite(dot_image);
    dots[i].SetOpacity(0);
}

# --- state ---------------------------------------------------------------------
mode = "normal";      # "normal" while booting, "password" while asking
typed = 0;            # how many characters have been typed
fade = 0;             # frames since start, drives the fade-in
built_w = 0;          # field width the stretched middles were last built for

fun draw() {
    local.o = fade / 40;
    if (local.o > 1) local.o = 1;

    local.shown = typed;
    if (local.shown > max_dots) local.shown = max_dots;

    # widths follow the number of dots, never smaller than the empty size
    local.field_w = local.shown * dot_step + 2 * field_pad;
    if (local.field_w < field_min_w) local.field_w = field_min_w;
    local.box_w = local.field_w + box_extra;
    local.field_x = Math.Int(screen_w / 2 - local.field_w / 2);
    local.box_x = Math.Int(screen_w / 2 - local.box_w / 2);

    if (local.field_w != built_w) {
        box_m.SetImage(box_m_image.Scale(local.box_w - 2 * box_cap, box_h));
        field_m.SetImage(field_m_image.Scale(local.field_w - 2 * field_cap, field_h));
        built_w = local.field_w;
    }

    box_l.SetPosition(local.box_x, box_y, 10);
    box_m.SetPosition(local.box_x + box_cap, box_y, 10);
    box_r.SetPosition(local.box_x + local.box_w - box_cap, box_y, 10);
    field_l.SetPosition(local.field_x, field_y, 11);
    field_m.SetPosition(local.field_x + field_cap, field_y, 11);
    field_r.SetPosition(local.field_x + local.field_w - field_cap, field_y, 11);

    if (mode == "password") {
        title.SetOpacity(local.o);
        box_l.SetOpacity(local.o);
        box_m.SetOpacity(local.o);
        box_r.SetOpacity(local.o);
        field_l.SetOpacity(local.o);
        field_m.SetOpacity(local.o);
        field_r.SetOpacity(local.o);
    } else {
        title.SetOpacity(0);
        box_l.SetOpacity(0);
        box_m.SetOpacity(0);
        box_r.SetOpacity(0);
        field_l.SetOpacity(0);
        field_m.SetOpacity(0);
        field_r.SetOpacity(0);
    }

    local.start = screen_w / 2 - (local.shown * dot_step) / 2 + (dot_step - dot_image.GetWidth()) / 2;
    for (local.i = 0; local.i < max_dots; local.i++) {
        if (mode == "password" && local.i < local.shown) {
            dots[local.i].SetPosition(local.start + local.i * dot_step,
                                      field_y + field_h / 2 - dot_image.GetHeight() / 2, 12);
            dots[local.i].SetOpacity(local.o);
        } else {
            dots[local.i].SetOpacity(0);
        }
    }
}

fun password_callback(prompt, bullets) {
    mode = "password";
    typed = bullets;
    draw();
}

fun normal_callback() {
    mode = "normal";
    typed = 0;
    draw();
}

fun refresh_callback() {
    if (fade < 40) {
        fade++;
        draw();
    }
}

Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayNormalFunction(normal_callback);
Plymouth.SetRefreshFunction(refresh_callback);

draw();

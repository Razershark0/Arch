#!/usr/bin/env bash

VERBOSE=false

BIN_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
if [ -z "$SERPANTINUM_DIR" ]; then
    export SERPANTINUM_DIR="$(dirname "$BIN_DIR")/src"
fi

source "$SERPANTINUM_DIR/scripts/caching.sh"

if [ -z "$MAIN_QML" ]; then
    export MAIN_QML="$SERPANTINUM_DIR/quickshell/Shell.qml"
fi

PIDFILE="/tmp/serpantinumd.pid"
LOCKFILE="/tmp/serpantinumd.lock"

is_alive() {
    local pid="$1"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    if [ -f "/proc/$pid/status" ] && grep -q '^State:[[:space:]]*Z' "/proc/$pid/status" 2>/dev/null; then
        return 1
    fi
    return 0
}

terminate_and_wait() {
    local pid="$1"
    local timeout="${2:-2}"
    local count=0
    local max_count=$(( timeout * 10 ))

    [ -n "$pid" ] && is_alive "$pid" || return 0

    kill -TERM "$pid" 2>/dev/null
    while is_alive "$pid" && [ "$count" -lt "$max_count" ]; do
        sleep 0.1
        ((count++))
    done
    is_alive "$pid" && kill -KILL "$pid" 2>/dev/null
}

show_help() {
    echo "Usage: serpantinumd [command] [options]"
    echo ""
    echo "Commands:"
    echo "  start      Start the serpantinum daemon (default)"
    echo "  stop       Stop the serpantinum daemon"
    echo "  status     Show whether the daemon is running"
    echo ""
    echo "Options:"
    echo "  -v, --verbose"
    echo "  -h, --help"
}

COMMAND=""
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose) VERBOSE=true; shift ;;
        -h|--help) show_help; exit 0 ;;
        start|stop|status) [ -z "$COMMAND" ] && COMMAND="$1"; shift ;;
        *) echo "Unknown argument: $1"; show_help; exit 1 ;;
    esac
done
[ -z "$COMMAND" ] && COMMAND="start"

if [ "$COMMAND" == "stop" ]; then
    pid=""
    [ -f "$PIDFILE" ] && pid="$(cat "$PIDFILE" 2>/dev/null)"
    [ -n "$MAIN_QML" ] && pkill -TERM -f "quickshell.*$MAIN_QML" 2>/dev/null

    if [ -n "$pid" ] && is_alive "$pid"; then
        terminate_and_wait "$pid" 2
    fi

    [ -n "$MAIN_QML" ] && pkill -KILL -f "quickshell.*$MAIN_QML" 2>/dev/null
    rm -f "$PIDFILE" "$LOCKFILE" 2>/dev/null
    echo "serpantinum daemon stopped."
    exit 0
fi

if [ "$COMMAND" == "status" ]; then
    pid=""
    [ -f "$PIDFILE" ] && pid="$(cat "$PIDFILE" 2>/dev/null)"
    if [ -n "$pid" ] && is_alive "$pid"; then
        echo "Running (PID $pid)"
        exit 0
    fi
    echo "Not running"
    exit 1
fi

if [ "$COMMAND" == "start" ]; then
    exec 9>"$LOCKFILE"
    if ! flock -n 9; then
        existing_pid=""
        [ -f "$PIDFILE" ] && existing_pid="$(cat "$PIDFILE" 2>/dev/null)"
        if [ -n "$existing_pid" ] && is_alive "$existing_pid"; then
            echo "serpantinum is already running (PID $existing_pid)."
            exit 1
        fi
        sleep 0.2
        if ! flock -n 9; then
            echo "serpantinum is already running."
            exit 1
        fi
    fi

    echo $$ > "$PIDFILE"

    CLEANUP_DONE=false
    QS_PID=""

    cleanup() {
        [ "$CLEANUP_DONE" = true ] && return
        CLEANUP_DONE=true
        trap '' SIGINT SIGTERM SIGHUP

        [ -n "$QS_PID" ] && is_alive "$QS_PID" && kill -TERM "$QS_PID" 2>/dev/null

        local count=0
        while [ -n "$QS_PID" ] && is_alive "$QS_PID" && [ "$count" -lt 10 ]; do
            sleep 0.1
            ((count++))
        done
        [ -n "$QS_PID" ] && is_alive "$QS_PID" && kill -KILL "$QS_PID" 2>/dev/null

        exec 9>&- 2>/dev/null
        rm -f "$PIDFILE" "$LOCKFILE" 2>/dev/null
        exit 0
    }
    trap cleanup SIGINT SIGTERM SIGHUP EXIT

    [ "$VERBOSE" = true ] && echo "Launching serpantinum..."

    quickshell -p "$MAIN_QML" 9>&- &
    QS_PID=$!
    wait $QS_PID
fi
